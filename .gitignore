# ============================================================
#  master-tampermonkey 分支专用 .gitignore
#  分支定位：油猴脚本（Tampermonkey），纯 JS，无 Python、无打包二进制
# ------------------------------------------------------------
#  本文件独立于 master 分支，不继承其内容。
#  这里显式忽略"其他分支产生、但本分支不需要"的产物（build/、settings.json 等），
#  原因是本分支是 orphan 分支，但工作区与 master 共用同一个目录：
#  切回本分支后，master 留下的未跟踪产物仍会出现在 git status 里。
#  忽略它们即可让本分支的 git status 保持干净，且不会误提交。
# ============================================================


# ------------------------------------------------------------
# 一、其他分支（桌面版 PyQt6 分支）的构建 / 运行产物
#     本分支完全不需要，但工作区里会残留
# ------------------------------------------------------------

# PyInstaller 打包产物（master 的 build.bat 生成）
# 注意：本分支的开发脚本刻意放在 scripts/，就是为了避开这个目录名
build/
*.spec

# 构建产物（本分支的 dist/szu_bkxk.user.js 由此产出）
dist/

# 桌面版运行期设置（本地开关，含用户偏好；本分支用 localStorage 存设置）
settings.json
settings_default.json

# 桌面版本地状态（含个人选课偏好，绝不入库）
courses_cache.json
tasks_config.json
debug.log

# 日志
logs/
*.log

# Python 字节码与虚拟环境
__pycache__/
*.py[codz]
.venv/
venv/


# ------------------------------------------------------------
# 二、桌面版遗留目录（切到本分支后不会被删除，但不是本分支的内容）
#     注意：docs/ 只在 master 被跟踪，本分支的 docs/ 是自己新增的，
#          因此不能整体忽略；这些目录在 master 被跟踪、本分支不跟踪任何内容，
#          所以需逐条忽略其残留文件。
# ------------------------------------------------------------
szu/
tools/
vendor/


# ------------------------------------------------------------
# 三、浏览器 profile 与登录态（含 cookie/登录凭据，绝不入库）
# ------------------------------------------------------------
.webview2_profile*/
.edge_real_profile/
.edge_profile/
.edge_spike*/


# ------------------------------------------------------------
# 四、本分支的脚本构建产物与本地测试痕迹
# ------------------------------------------------------------
node_modules/

# 本地构建出的单文件脚本（发布时走 Release / 显式 git add -f）
# dist/ 已在上文随构造产物一并忽略；如需入库请单独 git add -f

# 临时校验脚本与离线快照
_*_check.*
_itest_out/
_itest_in/

# 本地保存的页面快照（可能混入个人数据；documents 里的脱敏快照另行显式提交）
*.snapshot.html
*.har

# 凭证 / 抓包（har.json 可能含 cookie 与学号，绝不入库）
har.json


# ------------------------------------------------------------
# 五、编辑器与操作系统
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
